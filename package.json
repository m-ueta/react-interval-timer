{
  "name": "react-interval-timer",
  "version": "1.0.5",
  "description": "React Component Wrapper for setTimeout and setInterval.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-ueta/react-interval-timer.git"
  },
  "author": "Masafumi Ueta <ueta.ms@gmail.com>",
  "bugs": {
    "url": "https://github.com/m-ueta/react-interval-timer/issues"
  },
  "homepage": "",
  "license": "MIT",
  "keywords": [
    "react",
    "interval",
    "timer",
    "timeout",
    "repeat",
    "setTimeout",
    "setInterval"
  ],
  "main": "lib/index.js",
  "module": "es/index.js",
  "files": [
    "es",
    "lib",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "clean": "rm -rf lib es",
    "prepublishOnly": "npm run clean && npm run build",
    "start": "vite",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:jest": "jest"
  },
  "peerDependencies": {
    "prop-types": "^15.x",
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "@rollup/plugin-babel": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.0.0",
    "vite": "^5.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transform": {
      "^.+\\.js$": "<rootDir>/jest.transform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|mjs)$"
    ]
  }
}
